# Backend HTTP port; reserved for the later Compose setup too.
PORT=4000
# Local MongoDB database (Compose will use the mongo service hostname).
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow
# Comma-separated browser origins allowed to read the API.
CORS_ORIGINS=http://localhost:3000
# Runtime mode: development, test, or production.
NODE_ENV=development
# Structured logging: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info
# Reserved for the frontend phase; includes the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
