# Backend host port; Compose keeps its internal backend port at 4000.
PORT=4000
# Manual local database; Compose uses its private mongo service instead.
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow
# Comma-separated browser origins allowed to read the API.
CORS_ORIGINS=http://localhost:3000
# Runtime mode: development, test, or production.
NODE_ENV=development
# Structured logging: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info
# Browser-facing API URL, embedded in the frontend at build time; includes /api.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Frontend host port for Compose; internal frontend port stays 3000.
FRONTEND_PORT=3000
