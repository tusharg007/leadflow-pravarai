# HTTP listen port.
PORT=4000
# MongoDB URI; use an isolated database when experimenting with seed --reset.
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow
# Comma-separated frontend origins (scheme, host, and optional port only).
CORS_ORIGINS=http://localhost:3000
# Runtime mode: development, test, or production.
NODE_ENV=development
# Structured log level; request bodies and credentials are excluded from logs.
LOG_LEVEL=info
# Seed calendar timezone; match the browser used for the demo.
TZ=Asia/Kolkata
